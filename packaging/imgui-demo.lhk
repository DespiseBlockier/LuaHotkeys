local window = defineGui("Imgui"):window("ImGui Demo", { width = 300, height = 264 })
local macros = window:tab("Macros")
local settings = window:tab("Settings")
local about = window:tab("About")

macros:label("Macro controls")
local actions = macros:dock()
local preview = actions:button("Preview")
local reset = actions:button("Reset")
local enabled = macros:toggle("Enabled", true)
local delay = macros:slider("Delay", 0, 1000, 250)
local mode = macros:dropdown("Mode", { "Type text", "Send keys", "Preview only" }, "Type text")
local style = macros:color("Button color", "#FF85A2")
local advanced = macros:folder("Advanced")
local message = advanced:input("Message", "Hello from LuaHotkeys")

local ending = settings:keybind("Key after message", "Enter")
settings:label("Click the picker, then press a key.")
about:label("A Dear ImGui window scripted in Lua.")

preview.pressed:connect(function()
    log(mode:get(), enabled:get(), delay:get(), message:get(), ending:get())
end)

reset.pressed:connect(function()
    enabled:set(true)
    delay:set(250)
    mode:set("Type text")
    style:set("#FF85A2")
end)

style.changed:connect(function(color)
    preview:set_color(color)
    reset:set_color(color)
end)
