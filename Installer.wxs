<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="LuaHotkeys" Language="1033" Version="$(var.ProductVersion)"
           Manufacturer="LuaHotkeys" UpgradeCode="{54B8D0E7-0923-46B0-8694-7F3280300F48}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LuaHotkeys.ico" SourceFile="$(var.ProjectDirectory)\assets\LuaHotkeys.ico" />
    <Property Id="ARPPRODUCTICON" Value="LuaHotkeys.ico" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of LuaHotkeys is already installed." />

    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\LuaHotkeys\Installer"
                      Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="LuaHotkeys">
          <Component Id="ApplicationFiles" Guid="{58AB4B46-39F7-4BE5-A573-21B4B7D1C806}">
            <File Id="LuaHotkeysExe" Source="$(var.AppDirectory)\LuaHotkeys.exe">
              <Shortcut Id="LuaHotkeysShortcut" Directory="ProgramMenuFolder" Name="LuaHotkeys"
                        Advertise="no" WorkingDirectory="INSTALLFOLDER" />
            </File>
            <File Id="LuaHotkeysUpdaterExe" Source="$(var.AppDirectory)\LuaHotkeysUpdater.exe">
              <Shortcut Id="LuaHotkeysUpdaterShortcut" Directory="ProgramMenuFolder" Name="Update LuaHotkeys"
                        Advertise="no" WorkingDirectory="INSTALLFOLDER" />
            </File>
            <File Id="LuaRuntimeDll" Source="$(var.AppDirectory)\lua5.1.dll" DefaultLanguage="0" />
            <File Id="LuaLicense" Source="$(var.AppDirectory)\Lua-LICENSE.txt" />
            <RegistryValue Root="HKCU" Key="Software\LuaHotkeys\Installer" Name="InstallFolder"
                           Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.lhk" Type="string" Value="LuaHotkeys.Script" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.lhk\OpenWithProgids"
                           Name="LuaHotkeys.Script" Type="string" Value="" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.lhk\ShellNew" Name="NullFile" Type="string" Value="" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.luahotkeys" Type="string" Value="LuaHotkeys.Script" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.luahotkeys\OpenWithProgids"
                           Name="LuaHotkeys.Script" Type="string" Value="" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script" Type="string" Value="LuaHotkeys Script" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\DefaultIcon"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot;,0" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\shell" Type="string" Value="open" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\shell\open"
                           Type="string" Value="Run with LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\shell\open\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; --run &quot;%1&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\shell\edit"
                           Type="string" Value="Edit in LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LuaHotkeys.Script\shell\edit\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; --edit &quot;%1&quot;" />

            <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.lhk\shell\edit"
                           Type="string" Value="Edit in LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.lhk\shell\edit\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; --edit &quot;%1&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.luahotkeys\shell\edit"
                           Type="string" Value="Edit in LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.luahotkeys\shell\edit\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; --edit &quot;%1&quot;" />

            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe"
                           Name="FriendlyAppName" Type="string" Value="LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe\SupportedTypes"
                           Name=".luahotkeys" Type="string" Value="" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe\SupportedTypes"
                           Name=".lhk" Type="string" Value="" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe\shell\open\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; &quot;%1&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe\shell\edit"
                           Type="string" Value="Edit in LuaHotkeys" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LuaHotkeys.exe\shell\edit\command"
                           Type="string" Value="&quot;[#LuaHotkeysExe]&quot; --edit &quot;%1&quot;" />
            <RemoveFolder Id="RemoveEmptyInstallFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <Feature Id="LuaHotkeysFeature" Title="LuaHotkeys" Level="1">
      <ComponentRef Id="ApplicationFiles" />
    </Feature>

    <CustomAction Id="RefreshExplorerAssociations" FileKey="LuaHotkeysExe" ExeCommand="--refresh-associations"
                  Execute="deferred" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RefreshExplorerAssociations" After="WriteRegistryValues">NOT (REMOVE = "ALL")</Custom>
    </InstallExecuteSequence>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">WIX_UPGRADE_DETECTED OR PATCH</Publish>

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="INSTALLFOLDER" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3">WIXUI_INSTALLDIR_VALID &lt;&gt; "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_INSTALLDIR_VALID = "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="INSTALLFOLDER" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4">WIXUI_INSTALLDIR_VALID &lt;&gt; "1"</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">WIX_UPGRADE_DETECTED OR PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">Installed AND NOT PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>
</Wix>
